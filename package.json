{
  "name": "tm-platform",
  "version": "0.0.0",
  "private": false,
  "description": "TM shared platform monorepo (packages + examples)",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "release:help": "node scripts/release.mjs --help",
    "release:login": "node scripts/release.mjs login",
    "release:list": "node scripts/release.mjs list",
    "release:build": "node scripts/release.mjs build",
    "release:publish": "node scripts/release.mjs publish",
    "release:publish:one": "node scripts/release.mjs publish-one"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11"
  }
}