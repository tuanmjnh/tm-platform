{
  "name": "tm-platform",
  "version": "0.0.0",
  "private": false,
  "description": "TM shared platform monorepo (packages + examples)",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "release:help": "node scripts/release.mjs --help",
    "release:login": "node scripts/release.mjs login",
    "release:list": "node scripts/release.mjs list",
    "release:build": "node scripts/release.mjs build",
    "release:publish": "node scripts/release.mjs publish",
    "release:publish:one": "node scripts/release.mjs publish-one",
    "release:publish:ai-client": "node scripts/release.mjs publish tm-ai-client",
    "release:publish:types": "node scripts/release.mjs publish tm-types",
    "release:publish:utils": "node scripts/release.mjs publish tm-utils",
    "release:publish:validators": "node scripts/release.mjs publish tm-validators",
    "release:publish:cut-core": "node scripts/release.mjs publish @tuanmjnh/tm-cut-core",
    "release:publish:hub-client": "node scripts/release.mjs publish @tuanmjnh/tm-hub-client",
    "release:publish:ui": "node scripts/release.mjs publish tm-ui",
    "adopt:ui": "node scripts/adopt-tm-ui.mjs",
    "tm-ui:registry": "node scripts/switch-tm-ui.mjs registry",
    "tm-ui:link": "node scripts/switch-tm-ui.mjs link",
    "release:publish:core": "node scripts/release.mjs publish tm-core"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11"
  }
}
