{
  "name": "@tuanmjnh/tm-core",
  "version": "0.1.2",
  "description": "Framework-free runtime helpers shared by the TM platform",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/prepare-dist.mjs",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test \"tests/**/*.test.mjs\"",
    "login": "npm login",
    "publish": "npm run build && npm publish ./dist",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "tm",
    "shared",
    "platform",
    "format",
    "media"
  ],
  "author": "tuanmjnh",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.2"
  }
}
