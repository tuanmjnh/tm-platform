{
  "name": "@tuanmjnh/tm-ui",
  "version": "0.1.0",
  "description": "Shared Nuxt UI components for the TM platform",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-sfc.mjs && node scripts/prepare-dist.mjs",
    "dev": "node scripts/build-sfc.mjs --watch",
    "prepublishOnly": "pnpm test && pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "login": "npm login",
    "publish": "npm run build && npm publish ./dist",
    "git:cache": "git rm -r --cached . && git add .",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "tm",
    "shared",
    "platform",
    "ui",
    "nuxt-ui"
  ],
  "author": "tuanmjnh",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vue/compiler-sfc": "^3.5.45",
    "esbuild": "^0.27.7",
    "typescript": "^5.7.2",
    "vue": "^3.5.45"
  }
}
